<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- =============================================================== -->
    <!-- Permissions -->
    <!-- =============================================================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- AdMob Advertising ID Permission
         Used ONLY for advertising and analytics purposes:
         - Serving personalized ads through Google AdMob
         - Measuring ad performance and analytics
         - Frequency capping
         User can opt-out via device settings: Settings > Google > Ads
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:name=".RoyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        tools:ignore="DiscouragedApi,LockedOrientationActivity">

        <!-- =============================================================== -->
        <!-- AdMob Configuration -->
        <!-- =============================================================== -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3612191981543807~8639804669" />

        <!-- AppLovin SDK key is set via AdSdkConfig.applovinSdkKey (BuildConfig),
             NOT via meta-data. AppLovin SDK 13+ rejects having both. -->

        <!-- =============================================================== -->
        <!-- App Widget -->
        <!-- =============================================================== -->
        <receiver
            android:name=".widget.ShortCommandWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/short_command_widget_info" />
        </receiver>

        <!-- Daily Trivia Notification: alarm-fire is an explicit-component broadcast (no
             intent-filter needed); BOOT_COMPLETED reschedules the alarm since alarms don't
             survive a reboot. exported=false is fine — BOOT_COMPLETED is a protected system
             broadcast still delivered to manifest-declared receivers regardless of exported. -->
        <receiver
            android:name=".feature.trivia.DailyTriviaReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- =============================================================== -->
        <!-- Main Activities -->
        <!-- =============================================================== -->

        <!-- Splash Screen (LAUNCHER) -->
        <activity
            android:name=".act.SplashAct"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".act.MainAct"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustNothing" />

        <!-- =============================================================== -->
        <!-- Element & Table Activities -->
        <!-- =============================================================== -->

        <activity
            android:name=".act.ElementInfoAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- Compare Elements Activity -->
        <activity
            android:name=".act.CompareAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- Flashcard Study Activity -->
        <activity
            android:name=".act.FlashcardAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- Periodic Trends Chart Activity -->
        <activity
            android:name=".act.TrendsChartAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- Unit Converter Activity -->
        <activity
            android:name=".act.UnitConverterAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- Achievements/Badges Activity -->
        <activity
            android:name=".act.BadgeAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".feature.vip.VipManagementAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />


        <activity
            android:name=".act.TableAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".act.IsotopesActExperimental"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- =============================================================== -->
        <!-- Chemistry Tools -->
        <!-- =============================================================== -->

        <activity
            android:name=".act.CalculatorAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".act.SolubilityAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".act.EquationBalancerAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".act.QuizAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".act.table.IonAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".act.table.ElectrodeAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".act.table.EquationsAct"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".act.table.PHAct"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".act.table.NuclideAct"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".act.table.DictionaryAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- =============================================================== -->
        <!-- Settings Activities -->
        <!-- =============================================================== -->

        <activity
            android:name=".act.SettingsAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".act.setting.FavoritePageAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.SettingsAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".act.setting.OrderAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.SettingsAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".act.setting.AboutAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.SettingsAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".act.setting.UnitAct"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".act.SettingsAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".act.setting.SubmitAct"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".act.SettingsAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".act.setting.LicensesAct"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".act.SettingsAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustNothing" />

        <!-- =============================================================== -->
        <!-- Experimental Features -->
        <!-- =============================================================== -->

        <activity
            android:name=".setting.ExperimentalAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.SettingsAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- Share element card as image (Intent.ACTION_SEND with image/png) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
