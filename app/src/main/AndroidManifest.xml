            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- =============================================================== -->
        <!-- Settings Activities -->
        <!-- =============================================================== -->

        <activity
            android:name=".act.SettingsAct"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".act.MainAct"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
