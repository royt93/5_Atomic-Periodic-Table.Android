<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <FrameLayout
        android:id="@+id/commonTitleBack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Subtle tint overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.08"
            android:background="?attr/colorPrimary" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/titleBox"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <!-- Back Button -->
                <ImageButton
                    android:id="@+id/backBtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/back_button"
                    android:rotation="180"
                    android:src="@drawable/ic_arrow_back_whit"
                    app:tint="?attr/colorOnSecondaryContainer"
                    tools:ignore="PrivateResource" />

                <!-- Share + Wikipedia Buttons -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/shareElementBtn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/share_element_button"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_baseline_ios_share_24"
                        app:tint="?attr/colorOnSecondaryContainer"
                        tools:ignore="PrivateResource" />

                    <ImageButton
                        android:id="@+id/wikipediaBtn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/wikipedia_button"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_wikipedia_logo"
                        app:tint="?attr/colorOnSecondaryContainer"
                        tools:ignore="PrivateResource" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Element Title -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/elementTitle"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="70dp"
                    android:layout_marginEnd="126dp"
                    android:gravity="center_vertical"
                    android:text="@string/periodic_table"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </FrameLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/commonTitleBack">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="16dp"
                android:background="?attr/colorSurface"
                app:cardCornerRadius="0dp"
                app:cardElevation="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="240dp">

                    <!-- Loading Indicator -->
                    <include
                        android:id="@+id/ldnPlace"
                        layout="@layout/view_loading_view"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center" />

                    <!-- Element Image -->
                    <ImageView
                        android:id="@+id/elementImage"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_background" />

                    <!-- Previous Button -->
                    <ImageButton
                        android:id="@+id/previousBtn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_margin="16dp"
                        android:background="@drawable/shape_toast"
                        android:backgroundTint="?attr/colorSurface"
                        android:contentDescription="@string/previous_button"
                        android:elevation="4dp"
                        android:padding="8dp"
                        android:rotation="180"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_back_whit"
                        app:tint="?attr/colorPrimary" />

                    <!-- Next Button -->
                    <ImageButton
                        android:id="@+id/nextBtn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_margin="16dp"
                        android:background="@drawable/shape_toast"
                        android:backgroundTint="?attr/colorSurface"
                        android:contentDescription="@string/next_button"
                        android:elevation="4dp"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_back_whit"
                        app:tint="?attr/colorPrimary" />

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- Ad Banner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <include
                    android:id="@+id/layoutAdBanner"
                    layout="@layout/layout_ad_banner" />

            </FrameLayout>

            <!-- Offline Divider (Hidden) -->
            <Space
                android:id="@+id/offlineDiv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Favorite Bar -->
            <include
                android:id="@+id/favoriteBarInclude"
                layout="@layout/view_favorite_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp" />

            <!-- Detail Sections -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <include
                android:id="@+id/overviewInc"
                layout="@layout/v_d_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/propertiesInc"
                layout="@layout/v_d_properties"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/temperaturesInc"
                layout="@layout/v_d_temperatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/atomicInc"
                layout="@layout/v_d_atomic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/electromagneticInc"
                layout="@layout/v_d_electromagnetic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/additionPhysics"
                layout="@layout/v_d_thermodynamic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/nuclearInc"
                layout="@layout/v_d_nuclear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Personal Notes Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/notesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:backgroundTint="?attr/colorSurfaceVariant">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/notesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notes_title"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/notesInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/notes_hint"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeColor="?attr/colorPrimary"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/notesInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:padding="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/notesSaveBtn"
                        style="@style/Widget.MaterialComponents.Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="16dp"
                        android:text="@string/notes_save"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_send"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:cornerRadius="100dp"
                        android:textColor="?attr/colorOnPrimary"
                        android:backgroundTint="?attr/colorPrimary" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.cardview.widget.CardView>

            <!-- Submit Data Issue Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/iBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/shape_toast"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:drawableStart="@drawable/ic_info"
                android:drawablePadding="8dp"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/submit_data_issue"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnSurface"
                tools:ignore="PrivateResource" />

            <!-- Bottom Padding -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </ScrollView>

    <!-- Dialog Overlays (Preserved) -->

    <!-- Shell Background Overlay -->
    <LinearLayout
        android:id="@+id/shellBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A8000000"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Emission Background Overlay - dim disabled -->
    <LinearLayout
        android:id="@+id/detailEmissionBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Shell View Dialog -->
    <include
        android:id="@+id/shell"
        layout="@layout/view_shell_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="100dp"
        android:elevation="112dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Emission Detail Dialog -->
    <include
        android:id="@+id/detailEmission"
        layout="@layout/view_detail_emission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:elevation="112dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
