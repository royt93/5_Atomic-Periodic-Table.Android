<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    tools:ignore="PrivateResource,HardcodedText">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/physicsProperties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Section Header with Colored Background -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryContainer"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/headerIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_heat"
                app:tint="?attr/colorPrimary" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/headerIcon"
                android:fontFamily="sans-serif-medium"
                android:text="@string/thermodynamic_properties"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="22sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Content Container -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Phase (STP) Card with Icon -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp">

                    <!-- Content -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="64dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvPhaseTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:drawableStart="@drawable/ic_data"
                            android:drawablePadding="10dp"
                            android:drawableTint="?attr/colorPrimary"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/phase_stp"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvPhaseText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.87"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/phase_text"
                            android:textColor="?attr/colorOnSurface"
                            android:textIsSelectable="true"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Phase Icon -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/phaseIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="12dp"
                        android:padding="8dp"
                        app:srcCompat="@drawable/ic_vector_solid"
                        app:tint="?attr/colorTertiary" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Divider -->
            <View
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:alpha="0.3"
                android:background="?attr/colorOutline" />

            <!-- Heat Properties Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Fusion Heat -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvFusionHeatTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:drawableStart="@drawable/ic_vaporization"
                        android:drawablePadding="10dp"
                        android:drawableTint="?attr/colorSecondary"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/fusion_heat"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvFusionHeatText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:alpha="0.87"
                        android:fontFamily="sans-serif"
                        android:text="@string/fusion_heat_text"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />

                    <!-- Specific Heat Capacity -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSpecificHeatTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/specific_heat_capacity"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSpecificHeatText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:alpha="0.87"
                        android:fontFamily="sans-serif"
                        android:text="@string/specific_heat_text"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />

                    <!-- Vaporization Heat -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvVaporizationHeatTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/vaporization_heat"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvVaporizationHeatText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.87"
                        android:fontFamily="sans-serif"
                        android:text="@string/vaporization_heat_text"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.cardview.widget.CardView>
