                        android:paddingBottom="8dp"
                        android:text="@string/language_japanese"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="16sp" />
                </FrameLayout>

                <!-- 11. Korean -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.11"
                        android:background="?attr/colorPrimary" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/koreanBtn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_radio_unchecked"
                        android:drawablePadding="20dp"
                        android:focusable="true"
                        android:foreground="@drawable/ripple_d_ripple"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/language_korean"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="16sp" />
                </FrameLayout>

                <!-- 12. Portuguese -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.11"
                        android:background="?attr/colorPrimary" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/portugueseBtn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_radio_unchecked"
                        android:drawablePadding="20dp"
                        android:focusable="true"
                        android:foreground="@drawable/ripple_d_ripple"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/language_portuguese"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="16sp" />
                </FrameLayout>

                <!-- 13. Portuguese (Brazil) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.11"
                        android:background="?attr/colorPrimary" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/portugueseBrazilBtn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_radio_unchecked"
                        android:drawablePadding="20dp"
                        android:focusable="true"
                        android:foreground="@drawable/ripple_d_ripple"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/language_portuguese_brazil"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="16sp" />
                </FrameLayout>

                <!-- 14. Russian -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.11"
                        android:background="?attr/colorPrimary" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/russianBtn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_radio_unchecked"
                        android:drawablePadding="20dp"
                        android:focusable="true"
                        android:foreground="@drawable/ripple_d_ripple"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/language_russian"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="16sp" />
                </FrameLayout>

                <!-- 15. Spanish -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.11"
                        android:background="?attr/colorPrimary" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/spanishBtn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_radio_unchecked"
                        android:drawablePadding="20dp"
                        android:focusable="true"
                        android:foreground="@drawable/ripple_d_ripple"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/language_spanish"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="16sp" />
