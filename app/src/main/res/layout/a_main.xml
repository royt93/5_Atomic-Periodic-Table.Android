                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/top_number14"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:elevation="24dp"
                    android:gravity="center"
                    android:text="14"
                    android:textColor="?attr/actionMenuTextColor"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/top_number15"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:elevation="24dp"
                    android:gravity="center"
                    android:text="15"
                    android:textColor="?attr/actionMenuTextColor"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/top_number16"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:elevation="24dp"
                    android:gravity="center"
                    android:text="16"
                    android:textColor="?attr/actionMenuTextColor"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/top_number17"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:elevation="24dp"
                    android:gravity="center"
                    android:text="17"
                    android:textColor="?attr/actionMenuTextColor"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/top_number18"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:elevation="24dp"
                    android:gravity="center"
                    android:text="18"
                    android:textColor="?attr/actionMenuTextColor"
                    android:textSize="14sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/leftBar"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_marginTop="104dp"
            android:background="?attr/colorSurface"
            android:clickable="true"
            android:elevation="4dp"
            android:fadeScrollbars="true"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="36dp"
            android:focusable="true"
            android:scrollIndicators="none"
            android:scrollbarFadeDuration="24"
            android:scrollbarThumbHorizontal="@color/transparent"
            android:scrollbarThumbVertical="@color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/list_numbers"
                    android:layout_width="32dp"
                    android:layout_height="96dp"
                    android:layout_gravity="end"
                    android:elevation="24dp"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="?attr/actionMenuTextColor"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="96dp"
                    android:layout_gravity="end"
                    android:elevation="24dp"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="?attr/actionMenuTextColor"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/list_numbers3"
