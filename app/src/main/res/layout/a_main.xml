                    android:layout_weight="1"
                    android:elevation="24dp"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="?attr/actionMenuTextColor"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/top_number5"
