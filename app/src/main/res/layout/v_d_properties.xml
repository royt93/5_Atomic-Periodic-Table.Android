<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    tools:ignore="PrivateResource,HardcodedText">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Section Header with Colored Background -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryContainer"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/headerIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_isotopes"
                app:tint="?attr/colorPrimary" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/headerIcon"
                android:fontFamily="sans-serif-medium"
                android:text="@string/properties"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="22sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Content Container -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Basic Properties Card (Atomic Number + Atomic Weight) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Atomic Number -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/elementAtomicNumberTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:drawableStart="@drawable/ic_nucleari"
                        android:drawablePadding="10dp"
                        android:drawableTint="?attr/colorPrimary"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/atomic_number"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/elementAtomicNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:alpha="0.87"
                        android:fontFamily="sans-serif"
                        android:text="@string/element_name"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />

                    <!-- Atomic Weight -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/elementAtomicWeightTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/atomic_weight_relative_atomic_mass"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/elementAtomicWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.87"
                        android:fontFamily="sans-serif"
                        android:text="@string/element_name"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:alpha="0.3"
                android:background="?attr/colorOutline" />

            <!-- Physical Properties Card (Density + Electronegativity + Block) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Density -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/elementDensityTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:drawableStart="@drawable/ic_weight_outline"
                        android:drawablePadding="10dp"
                        android:drawableTint="?attr/colorSecondary"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/density"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/elementDensity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:alpha="0.87"
                        android:fontFamily="sans-serif"
                        android:text="@string/element_name"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />

                    <!-- Electronegativity -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/elementElectronegativtyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/electronegativity"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/elementElectronegativty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:alpha="0.87"
                        android:fontFamily="sans-serif"
                        android:text="@string/element_name"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />

                    <!-- Block -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/elementBlockTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/block"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/elementBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.87"
                        android:fontFamily="sans-serif"
                        android:text="@string/element_block"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Divider -->
            <View
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:alpha="0.3"
                android:background="?attr/colorOutline" />

            <!-- Electron Shell Model Card (Interactive) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/electronView"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Left side content -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="140dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="16dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/electronShell"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:drawableStart="@drawable/ic_nucleari"
                            android:drawablePadding="10dp"
                            android:drawableTint="?attr/colorOnSecondaryContainer"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/electron_shell"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/elementShellsElectrons"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.87"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/element_electrons"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:textIsSelectable="true"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Model Image -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/modelView"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="8dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_launcher_background" />

                    <!-- Open Button -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/openBtn"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end|top"
                        android:layout_margin="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:elevation="4dp"
                        android:padding="6dp"
                        app:srcCompat="@drawable/ic_open"
                        app:tint="?attr/colorOnSecondaryContainer" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Divider -->
            <View
                android:id="@+id/textView32"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:alpha="0.3"
                android:background="?attr/colorOutline" />

            <!-- Emission Spectrum Section -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/spLinesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:drawableStart="@drawable/ic_data"
                android:drawablePadding="10dp"
                android:drawableTint="?attr/colorTertiary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/emission_spectrum"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Offline Message -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/spOffline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0.7"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/go_online_for_emission_lines"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Emission Spectrum Card (Interactive) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Spectrum Image -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/spImg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:minHeight="120dp"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/ic_launcher_background" />

                    <!-- Open Button -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/openBtn2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end|top"
                        android:layout_margin="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:elevation="4dp"
                        android:padding="6dp"
                        app:srcCompat="@drawable/ic_open"
                        app:tint="?attr/colorTertiary" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.cardview.widget.CardView>
