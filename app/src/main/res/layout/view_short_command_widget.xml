<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_toast_widget"
    android:backgroundTint="#ffff"
    android:padding="@dimen/widget_margin"
    android:theme="@style/ThemeOverlay.Science.AppWidgetContainer">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_margin="8dp"
        android:background="?attr/appWidgetBackgroundColor"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWidgetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/appwidget_text"
            android:textColor="?attr/appWidgetTextColor"
            android:textSize="24sp"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/tvWidgetFact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="?attr/appWidgetTextColor"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvWidgetResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/appWidgetTextColor"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widgetAnswersRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widgetAnswer1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_toast_widget"
                    android:backgroundTint="?attr/appWidgetTextColor"
                    android:maxLines="1"
                    android:padding="6dp"
                    android:textColor="?attr/appWidgetBackgroundColor"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widgetAnswer2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_toast_widget"
                    android:backgroundTint="?attr/appWidgetTextColor"
                    android:maxLines="1"
                    android:padding="6dp"
                    android:textColor="?attr/appWidgetBackgroundColor"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widgetAnswer3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_toast_widget"
                    android:backgroundTint="?attr/appWidgetTextColor"
                    android:maxLines="1"
                    android:padding="6dp"
                    android:textColor="?attr/appWidgetBackgroundColor"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widgetAnswer4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_toast_widget"
                    android:backgroundTint="?attr/appWidgetTextColor"
                    android:maxLines="1"
                    android:padding="6dp"
                    android:textColor="?attr/appWidgetBackgroundColor"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
