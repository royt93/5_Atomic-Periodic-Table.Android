    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="288dp"
    tools:ignore="HardcodedText,PrivateResource,SmallSp">

    <FrameLayout
        android:id="@+id/cobaltFrame"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_margin="2dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="2dp"
        android:elevation="0dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cobalt_btn"
            android:layout_width="80dp"
            android:layout_height="78dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_element_nodetail"
            android:elevation="2dp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cobalt_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:alpha="0.85"
            android:elevation="24dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="top|end"
            android:text="27"
            android:textAlignment="gravity"
            android:textColor="?attr/actionMenuTextColor"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cobalt_element"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="24dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Co"
            android:textColor="?attr/actionMenuTextColor"
            android:textSize="28sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cobalt_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="16dp"
            android:alpha="0.75"
            android:elevation="24dp"
            android:fontFamily="sans-serif"
            android:gravity="bottom|center_horizontal"
            android:text="Cobalt"
            android:textColor="?attr/actionMenuTextColor"
            android:textSize="9sp" />
    </FrameLayout>

