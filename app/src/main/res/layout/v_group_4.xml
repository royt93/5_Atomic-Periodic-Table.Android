    <FrameLayout
        android:id="@+id/titanium_frame"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_margin="2dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="2dp"
        android:elevation="0dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/titanium_btn"
            android:layout_width="80dp"
            android:layout_height="78dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_element_nodetail"
            android:elevation="2dp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/titanium_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:alpha="0.85"
            android:elevation="24dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="top|end"
            android:text="22"
            android:textAlignment="gravity"
            android:textColor="?attr/actionMenuTextColor"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/titanium_element"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="24dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Ti"
            android:textColor="?attr/actionMenuTextColor"
            android:textSize="28sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/titanium_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="16dp"
            android:alpha="0.75"
            android:elevation="24dp"
            android:fontFamily="sans-serif"
            android:gravity="bottom|center_horizontal"
            android:text="Titanium"
            android:textColor="?attr/actionMenuTextColor"
            android:textSize="9sp" />
    </FrameLayout>

