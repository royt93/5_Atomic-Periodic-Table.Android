<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/compareRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">

    <!-- ================================================================ -->
    <!-- Title Bar -->
    <!-- ================================================================ -->
    <FrameLayout
        android:id="@+id/compareTitleBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Subtle tint overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.08"
            android:background="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <!-- Back Button -->
                <ImageButton
                    android:id="@+id/compareBackBtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/back_button"
                    android:rotation="180"
                    android:src="@drawable/ic_arrow_back_whit"
                    app:tint="?attr/colorOnSecondaryContainer"
                    tools:ignore="PrivateResource" />

                <!-- Title -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginStart="64dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical"
                    android:text="@string/compare_elements_title"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ================================================================ -->
    <!-- Scrollable Content -->
    <!-- ================================================================ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/compareScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/compareTitleBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ============================================================ -->
            <!-- Element Picker Cards -->
            <!-- ============================================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Element 1 Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardElement1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/compare_element_a"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <!-- Pill showing the selected element -->
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvElement1Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="H\nHydrogen" />

                        <!-- Search Input -->
                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/searchElement1"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/shape_search_bar"
                            android:hint="@string/compare_search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp" />

                        <!-- Dropdown for Element 1 -->
                        <LinearLayout
                            android:id="@+id/dropdownElement1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/colorSurface"
                            android:elevation="4dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- VS spacer -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center"
                    android:text="VS"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Element 2 Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardElement2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/compare_element_b"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <!-- Pill showing the selected element -->
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvElement2Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="He\nHelium" />

                        <!-- Search Input -->
                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/searchElement2"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/shape_search_bar"
                            android:hint="@string/compare_search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp" />

                        <!-- Dropdown for Element 2 -->
                        <LinearLayout
                            android:id="@+id/dropdownElement2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/colorSurface"
                            android:elevation="4dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ============================================================ -->
            <!-- Table Header -->
            <!-- ============================================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/colorPrimary"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="2.2"
                    android:paddingStart="12dp"
                    android:text="@string/compare_property"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvHeaderElement1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:text="@string/compare_element_a"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="0.5"
                    android:gravity="center"
                    android:text=""
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvHeaderElement2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:paddingEnd="8dp"
                    android:text="@string/compare_element_b"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ============================================================ -->
            <!-- Rows Container (populated dynamically) -->
            <!-- ============================================================ -->
            <LinearLayout
                android:id="@+id/compareTableBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/colorSurface"
                android:orientation="vertical" />


            <!-- Legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲"
                    android:textColor="@color/compare_higher"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/compare_legend_higher"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="▼"
                    android:textColor="@color/compare_lower"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/compare_legend_lower"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
