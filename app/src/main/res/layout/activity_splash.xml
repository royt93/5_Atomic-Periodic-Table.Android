<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorThemePrimary">

    <!-- Background Decorative Circle 1 -->
    <View
        android:id="@+id/decorCircle1"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp"
        android:alpha="0.05"
        android:background="@drawable/shape_circle"
        android:backgroundTint="@color/colorThemeAccent" />

    <!-- Background Decorative Circle 2 -->
    <View
        android:id="@+id/decorCircle2"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-80dp"
        android:layout_marginBottom="-80dp"
        android:alpha="0.04"
        android:background="@drawable/shape_circle"
        android:backgroundTint="@color/colorThemeAccent" />

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Spacer for top -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- App Logo -->
        <FrameLayout
            android:id="@+id/logoCard"
            android:layout_width="280dp"
            android:layout_height="160dp">

            <ImageView
                android:id="@+id/appLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/splash_logo" />

        </FrameLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/appNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/app_name"
            android:textColor="@color/colorThemeText"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Loading Text -->
        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:alpha="0.87"
            android:text="@string/loading"
            android:textColor="@color/colorThemeText"
            android:textSize="15sp" />

        <!-- Progress Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            style="@style/Widget.Material3.LinearProgressIndicator"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            app:indicatorColor="@color/colorThemeAccent"
            app:trackColor="@color/colorThemeSurfaceVariant"
            app:trackCornerRadius="8dp"
            app:trackThickness="6dp" />

        <!-- Spacer for bottom -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Ad Notice -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:alpha="0.70"
            android:text="@string/ads_notice"
            android:textColor="@color/colorThemeTextSecondary"
            android:textSize="13sp"
            android:textStyle="italic" />

        <!-- Version Info -->
        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:alpha="0.50"
            android:textColor="@color/colorThemeTextSecondary"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
