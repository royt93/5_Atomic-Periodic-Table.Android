<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:elevation="12dp"
    tools:ignore="PrivateResource">

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Empty State -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/emptySearchBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="56dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="42dp"
            android:paddingEnd="42dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivEmptyEleSearchImage"
                android:layout_width="164dp"
                android:layout_height="164dp"
                android:layout_marginBottom="32dp"
                app:srcCompat="@drawable/bkg_graphic_light_search" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="@string/no_results"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:gravity="center"
                android:text="@string/try_searching_for_another_word_or_check_your_spelling"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Results List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvElement"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="60dp"
            android:scrollbarStyle="insideOverlay"
            android:scrollbars="vertical" />

        <!-- Search Bar -->
        <FrameLayout
            android:id="@+id/commonTitleBackSearch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/colorSurface"
            android:elevation="8dp">

            <!-- Tint Overlay -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.08"
                android:background="?attr/colorPrimary" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- Close Button -->
                <ImageButton
                    android:id="@+id/closeElementSearch"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back_button"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <!-- Search Input -->
                <FrameLayout
                    android:id="@+id/flSearchBarElement"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_toast"
                    android:backgroundTint="?attr/colorSurfaceVariant">

                    <EditText
                        android:id="@+id/editElement"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="@string/search_for_elements"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />

                </FrameLayout>

                <!-- Filter Button -->
                <ImageButton
                    android:id="@+id/btFilterBtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/filter"
                    android:src="@drawable/ic_sort"
                    app:tint="?attr/colorOnSecondaryContainer" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </FrameLayout>

    </FrameLayout>

    <!-- Background Overlay for Filter -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Filter Panel -->
    <include
        android:id="@+id/filterBox"
        layout="@layout/view_filter_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="8dp"
        android:elevation="12dp" />

</FrameLayout>
