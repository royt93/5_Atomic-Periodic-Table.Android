<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and below
    Specifies which files should be included/excluded from cloud backups
-->
<full-backup-content>
    <!-- Include app preferences -->
    <include domain="sharedpref" path="." />

    <!-- Include database files -->
    <include domain="database" path="." />
</full-backup-content>
