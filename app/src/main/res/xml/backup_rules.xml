<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and below
    Specifies which files should be included/excluded from cloud backups
-->
<full-backup-content>
    <!-- Include app preferences -->
    <include domain="sharedpref" path="." />
    <!-- VIP entitlement metadata must not be restorable via backup/transfer (FIX-005) -->
    <exclude domain="sharedpref" path="vip_screen_prefs.xml" />
    <!-- Third-party AdManager SDK's own prefs file (com.roy.sdkadbmob:AppPreferences) — holds
         its own VIP entitlement flags plus GAID list and ad-safety counters. -->
    <exclude domain="sharedpref" path="loitp_admob.xml" />

    <!-- Include database files -->
    <include domain="database" path="." />
</full-backup-content>
