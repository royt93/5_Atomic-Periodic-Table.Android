<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12 and higher
    Controls cloud backups and device-to-device transfers
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include app preferences in cloud backup -->
        <include domain="sharedpref" path="." />

        <!-- Include database files in cloud backup -->
        <include domain="database" path="." />

        <!-- Exclude cache from cloud backup -->
        <exclude domain="file" path="cache/" />

        <!-- Exclude temp files from cloud backup -->
        <exclude domain="file" path="tmp/" />

        <!-- Exclude large media files from cloud backup -->
        <exclude domain="file" path="images/" />
    </cloud-backup>

    <device-transfer>
        <!-- Include app preferences in device transfer -->
        <include domain="sharedpref" path="." />

        <!-- Include database files in device transfer -->
        <include domain="database" path="." />

        <!-- Exclude cache from device transfer -->
        <exclude domain="file" path="cache/" />

        <!-- Exclude temp files from device transfer -->
        <exclude domain="file" path="tmp/" />
    </device-transfer>
</data-extraction-rules>
