<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12 and higher
    Controls cloud backups and device-to-device transfers
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include app preferences in cloud backup -->
        <include domain="sharedpref" path="." />

        <!-- Include database files in cloud backup -->
        <include domain="database" path="." />
    </cloud-backup>

    <device-transfer>
        <!-- Include app preferences in device transfer -->
        <include domain="sharedpref" path="." />

        <!-- Include database files in device transfer -->
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
